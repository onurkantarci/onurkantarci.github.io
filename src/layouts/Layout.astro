---
const title = "Onur Kantarci | Full Stack Dev";
const description =
  "Onur Kantarci — full-stack developer and lawyer, building thoughtful and impactful web experiences.";
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Projects", href: "/projects/" },
];
const isActive = (href: string) =>
  (href.replace(/\/+$/, "") || "/") === currentPath;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101112" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Edu+AU+VIC+WA+NT+Hand:wght@400..700&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="/pictures/letter-o-or-a-bar-in-a-circle-svgrepo-com.svg"
      type="image/svg+xml"
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="nav-inner" aria-label="Main navigation">
          <a class="onurk" href="/" aria-label="Onur Kantarci — homepage">
            <span class="brand-symbol" aria-hidden="true">&lt;/&gt;</span>
            <span>onurk<span class="brand-dot">.</span>dev</span>
          </a>

          <ul class="desktop-nav">
            {
              navItems.map(({ label, href }) => (
                <li>
                  <a
                    class:list={["nav-link", { active: isActive(href) }]}
                    href={href}
                    aria-current={isActive(href) ? "page" : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>

          <details class="mobile-menu">
            <summary aria-label="Toggle navigation menu">
              <span class="menu-lines" aria-hidden="true"
                ><span></span><span></span><span></span></span
              >
            </summary>
            <div class="mobile-panel">
              {
                navItems.map(({ label, href }) => (
                  <a
                    class:list={["mobile-link", { active: isActive(href) }]}
                    href={href}
                    aria-current={isActive(href) ? "page" : undefined}
                  >
                    {label} <span aria-hidden="true">↗</span>
                  </a>
                ))
              }
              <a
                class="mobile-link mobile-cta"
                href="mailto:onur.kantarci@hotmail.com"
              >
                Get in touch <span aria-hidden="true">↗</span>
              </a>
            </div>
          </details>
        </nav>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-main">
            <div class="footer-identity">
              <a href="/" class="footer-logo">onurk<span>.</span>dev</a>
              <p>One line of code at a time.</p>
            </div>
            <div class="footer-links-group">
              <div class="footer-column">
                <span class="footer-heading">EXPLORE</span>
                <a href="/">Home</a>
                <a href="/about/">About</a>
                <a href="/projects/">Projects</a>
                <a href="/technologies">Technologies</a>
              </div>
              <div class="footer-column">
                <span class="footer-heading">CONNECT</span>
                <a
                  href="https://github.com/onurkantarci"
                  target="_blank"
                  rel="noopener noreferrer"
                  >GitHub <span aria-hidden="true">↗</span></a
                >
                <a
                  href="https://linkedin.com/in/onur-kantarci"
                  target="_blank"
                  rel="noopener noreferrer"
                  >LinkedIn <span aria-hidden="true">↗</span></a
                >
                <a href="mailto:onur.kantarci@hotmail.com"
                  >Email <span aria-hidden="true">↗</span></a
                >
              </div>
            </div>
          </div>
          <div class="footer-bottom">
            <span
              >© {new Date().getFullYear()} Onur Kantarci. All rights reserved.</span
            >
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #101112;
    color: #f3f4f3;
  }
  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }
  :global(a:focus-visible),
  :global(summary:focus-visible) {
    outline: 2px solid #2ac670;
    outline-offset: 4px;
  }
  .site-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: "Roboto", sans-serif;
  }
  #main-content {
    flex: 1;
    min-width: 0;
    padding: 0;
    width: 100%;
  }

  .site-header {
    position: sticky;
    top: 0;
    width: 100%;
    padding: 0;
    display: block;
    box-sizing: border-box;
    z-index: 30;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(16, 17, 18, 0.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .nav-inner {
    width: min(1180px, calc(100% - 48px));
    min-height: 72px;
    padding: 0;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }
  .onurk {
    justify-self: start;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #fafafa;
    text-decoration: none;
    font-family: "Edu AU VIC WA NT Hand", cursive;
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -0.9px;
  }
  .brand-dot,
  .footer-logo span {
    color: #2ac670;
  }
  .brand-symbol {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(42, 198, 112, 0.22);
    border-radius: 10px;
    background: rgba(42, 198, 112, 0.09);
    color: #2ac670;
    font: 700 14px/1 monospace;
    letter-spacing: -2px;
  }
  .desktop-nav {
    justify-self: center;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.025);
  }
  .desktop-nav li {
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: block;
    border-radius: 8px;
    padding: 10px 18px;
    text-decoration: none;
    color: #a6a7ac;
    font-size: 13px;
    font-weight: 600;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav-link:hover {
    color: #f4f4f4;
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-link.active {
    color: #111a14;
    background: #2ac670;
    box-shadow: 0 0 24px rgba(42, 198, 112, 0.12);
  }
  .header-contact {
    justify-self: end;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 20px;
    border: 1px solid rgba(42, 198, 112, 0.3);
    background: rgba(42, 198, 112, 0.065);
    padding: 12px 18px;
    border-radius: 9px;
    color: #e9fbef;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .header-contact span {
    color: #2ac670;
    font-size: 17px;
  }
  .header-contact:hover {
    transform: translateY(-2px);
    background: rgba(42, 198, 112, 0.15);
    border-color: rgba(42, 198, 112, 0.65);
  }
  .mobile-menu {
    display: none;
  }

  .site-footer {
    width: 100%;
    padding: 0;
    text-align: left;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: #0d0f0e;
  }
  .footer-inner {
    width: min(1260px, calc(100% - 80px));
    margin: auto;
  }
  .footer-main {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding: 58px 0 55px;
  }
  .footer-identity {
    min-width: 0;
  }
  .footer-logo {
    display: inline-block;
    color: #f5f6f5;
    font-family: "Edu AU VIC WA NT Hand", cursive;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -0.8px;
    text-decoration: none;
  }
  .footer-identity p {
    margin: 15px 0 0;
    color: #888d89;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.8;
  }
  .footer-links-group {
    display: flex;
    gap: clamp(55px, 8vw, 130px);
    padding-right: 15px;
  }
  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .footer-heading {
    color: #5e7466;
    letter-spacing: 2px;
    font-size: 10px;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .footer-column a {
    text-decoration: none;
    color: #bec2bf;
    font-size: 13px;
    font-weight: 500;
    transition:
      color 0.2s,
      transform 0.2s;
  }
  .footer-column a:hover {
    color: #2ac670;
    transform: translateX(3px);
  }
  .footer-column a span {
    font-size: 13px;
    margin-left: 3px;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.075);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 23px 0 27px;
    color: #747c76;
    font-size: 12px;
  }
  .footer-signoff {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 1.6px;
    font-size: 10px;
    font-weight: 700;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    background: #2ac670;
    box-shadow: 0 0 12px rgba(42, 198, 112, 0.55);
  }

  @media (max-width: 760px) {
    .nav-inner,
    .footer-inner {
      width: min(100% - 36px, 1180px);
    }
    .nav-inner {
      min-height: 68px;
      display: flex;
      justify-content: space-between;
      gap: 14px;
    }
    .onurk {
      font-size: 21px;
    }
    .desktop-nav,
    .header-contact {
      display: none;
    }
    .mobile-menu {
      display: block;
      margin-left: auto;
      position: relative;
    }
    .mobile-menu summary {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      color: #fff;
      cursor: pointer;
      list-style: none;
    }
    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }
    .menu-lines {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .menu-lines span {
      display: block;
      height: 2px;
      width: 18px;
      border-radius: 2px;
      background: #e9eeea;
    }
    .mobile-menu[open] summary {
      border-color: #2ac670;
    }
    .mobile-panel {
      position: absolute;
      top: calc(100% + 14px);
      right: 0;
      width: min(300px, calc(100vw - 36px));
      padding: 10px;
      border: 1px solid #2b3430;
      border-radius: 14px;
      background: #191d1b;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    }
    .mobile-link {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding: 14px;
      text-decoration: none;
      color: #d2d7d3;
      font-size: 14px;
      font-weight: 600;
      border-radius: 9px;
    }
    .mobile-link:hover,
    .mobile-link.active {
      background: rgba(42, 198, 112, 0.12);
      color: #47d989;
    }
    .mobile-cta {
      margin-top: 6px;
      color: #101510;
      background: #2ac670;
    }
    .mobile-cta:hover {
      color: #101510;
      background: #49db8c;
    }
    .footer-main {
      padding: 44px 0;
      flex-direction: column;
      gap: 42px;
    }
    .footer-links-group {
      justify-content: flex-start;
      gap: min(20vw, 100px);
    }
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .nav-link,
    .header-contact,
    .footer-column a {
      transition: none;
    }
  }
</style>
