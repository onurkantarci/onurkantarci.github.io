<script>
    const searchInput =
        document.querySelector<HTMLInputElement>("#project-search");
    const countElement = document.querySelector<HTMLElement>("#visible-count");
    const noResults = document.querySelector<HTMLElement>("#no-results");
    const cards = [...document.querySelectorAll<HTMLElement>(".project-card")];
    searchInput?.addEventListener("input", () => {
        const term = searchInput.value.trim().toLocaleLowerCase();
        let visible = 0;
        cards.forEach((card) => {
            const matches = (card.dataset.search || "").includes(term);
            card.hidden = !matches;
            if (matches) visible++;
        });
        if (countElement) countElement.textContent = String(visible);
        if (noResults) noResults.hidden = visible !== 0;
    });
</script>

