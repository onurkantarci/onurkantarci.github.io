---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="home" id="home">
    <div class="ambient ambient-green" aria-hidden="true"></div>
    <div class="ambient ambient-orange" aria-hidden="true"></div>
    <div class="background-grid" aria-hidden="true"></div>

    <div class="side-note" aria-hidden="true">
      <span class="side-rule"></span>
      <span id="typing">innovative</span>
      <span class="side-caption">THINK · BUILD · IMPROVE</span>
    </div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="name-flag">
        <h1 class="onur-fullname" id="hero-title">
          ONUR <span>KANTARCI</span>
        </h1>
        <a
          class="flag-link"
          href="https://en.wikipedia.org/wiki/Kosovo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Learn about Kosovo"
        >
          <img
            class="flag"
            src="/pictures/Flag_of_Kosovo.svg"
            alt="Flag of Kosovo"
          />
        </a>
      </div>

      <a class="email" href="mailto:onur.kantarci@hotmail.com"
        ><span class="mail-dot"></span>onur.kantarci@hotmail.com <span
          class="email-arrow"
          aria-hidden="true">↗</span
        ></a
      >

      <div class="hero-divider" aria-hidden="true">
        <span></span><span class="divider-star">✳</span><span></span>
      </div>

      <h2 class="index-title">
        <span class="intro-word">A</span>
        <span class="role full-stack"
          >FULL-STACK DEVELOPER <span class="role-emoji" aria-hidden="true"
            >👨🏻‍💻</span
          ></span
        >
        <span class="intro-word">AND</span>
        <span class="role trainee-law"
          >LAWYER <span class="role-emoji" aria-hidden="true">⚖️</span></span
        >
      </h2>

      <p class="intro-description">
        I'm Onur Kantarci, a full-stack developer and lawyer with a passion for
        creating dynamic web applications. With two years of experience in <a
          href="/technologies"
          class="yellow-highlight"
          >most-used technologies, <span aria-hidden="true">↗</span></a
        > I bring a unique blend of legal insight and technical skills to build innovative
        and impactful solutions.
      </p>

      <div class="actions">
        <a
          href="/resume/Onur-Kantarci-Resume.pdf"
          download
          class="resume-download"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M12 3v12m-5-5 5 5 5-5M5 17v4h14v-4"></path></svg
          >
          Download Resume
          <span class="button-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="technologies-link" href="/technologies"
          >Explore my technologies <span aria-hidden="true">↗</span></a
        >
      </div>

      <div class="hero-bottom" aria-label="Professional interests">
        <div class="bottom-item">
          <span class="bottom-index">01</span><span>DEVELOPMENT</span>
        </div>
        <span class="bottom-separator"></span>
        <div class="bottom-item">
          <span class="bottom-index">02</span><span>LAW</span>
        </div>
        <span class="bottom-separator"></span>
        <div class="bottom-item">
          <span class="bottom-index">03</span><span>CREATIVITY</span>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const words = ["innovative", "impactful", "dynamic"];
  const typingElement = document.getElementById("typing");

  if (typingElement) {
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let timeout: ReturnType<typeof setTimeout>;

    function type() {
      if (!typingElement) return;

      const word = words[wordIndex];

      typingElement.textContent = word.slice(0, charIndex);

      if (!isDeleting && charIndex < word.length) {
        charIndex++;
        timeout = setTimeout(type, 120);
      } else if (isDeleting && charIndex > 0) {
        charIndex--;
        timeout = setTimeout(type, 65);
      } else {
        if (!isDeleting) {
          isDeleting = true;
          timeout = setTimeout(type, 1500);
        } else {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          timeout = setTimeout(type, 400);
        }
      }
    }

    type();

    document.addEventListener(
      "astro:before-swap",
      () => clearTimeout(timeout),
      { once: true },
    );
  }
</script>

<style>
  .home {
    --green: #2ac670;
    --orange: #e65f3f;
    --muted: #a0a2a8;
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
    min-height: min(900px, 100svh);
    padding: clamp(105px, 12vw, 155px) 36px 88px;
    overflow: hidden;
    background: #111113;
    color: #f4f4f5;
    font-family:
      "Roboto",
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }
  .home * {
    box-sizing: border-box;
  }
  .ambient,
  .background-grid {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .ambient {
    border-radius: 50%;
    filter: blur(80px);
  }
  .ambient-green {
    width: 480px;
    height: 480px;
    left: -250px;
    top: 10%;
    background: rgba(42, 198, 112, 0.065);
  }
  .ambient-orange {
    width: 480px;
    height: 480px;
    right: -260px;
    bottom: -200px;
    background: rgba(230, 95, 63, 0.055);
  }
  .background-grid {
    inset: 0;
    opacity: 0.26;
    background-image: linear-gradient(
        rgba(255, 255, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 45%, black, transparent 75%);
  }

  .hero {
    width: min(100%, 1020px);
    position: relative;
    text-align: center;
    animation: rise 0.65s ease both;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #989b9f;
    letter-spacing: 0.2em;
    font-size: 10px;
    font-weight: 750;
  }
  .eyebrow-dot,
  .mail-dot {
    display: inline-block;
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    background: var(--green);
    border-radius: 50%;
    box-shadow: 0 0 15px rgba(42, 198, 112, 0.6);
  }
  .eyebrow-line {
    width: 38px;
    height: 1px;
    background: #404044;
  }
  .name-flag {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 3vw, 28px);
    margin: 26px 0 9px;
  }
  .onur-fullname {
    margin: 0;
    font-size: clamp(43px, 8vw, 112px);
    font-weight: 850;
    line-height: 1.05;
    letter-spacing: -0.065em;
    color: #f7f7f8;
  }
  .onur-fullname > span {
    color: #f7f7f8;
  }
  .flag-link {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 43px;
    height: 43px;
    padding: 7px;
    background: #212124;
    border: 1px solid #36363a;
    border-radius: 50%;
    transition:
      transform 0.2s,
      border-color 0.2s;
  }
  .flag-link:hover {
    transform: translateY(-3px);
    border-color: var(--green);
  }
  .flag {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .email {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--green);
    text-decoration: none;
    font-size: clamp(13px, 1.5vw, 16px);
    letter-spacing: 0.025em;
    transition: color 0.2s;
  }
  .email:hover {
    color: #80edab;
  }
  .mail-dot {
    width: 6px;
    height: 6px;
  }
  .email-arrow {
    font-size: 17px;
    opacity: 0.7;
  }
  .hero-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin: clamp(32px, 5vw, 57px) auto 32px;
    max-width: 600px;
  }
  .hero-divider > span:not(.divider-star) {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, #343439);
  }
  .hero-divider > span:last-child {
    transform: rotate(180deg);
  }
  .divider-star {
    color: #606066;
    font-size: 16px;
  }
  .index-title {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 14px;
    font-size: clamp(15px, 1.75vw, 20px);
    font-weight: 700;
    letter-spacing: 0.015em;
  }
  .intro-word {
    color: #eeeef0;
  }
  .role {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px dashed #414146;
    border-radius: 11px;
    background: #202023;
    padding: 12px 17px;
    font-size: clamp(13px, 1.4vw, 17px);
    transition:
      transform 0.2s,
      border-color 0.2s,
      background 0.2s;
  }
  .role:hover {
    transform: translateY(-3px);
    background: #28282c;
    border-color: #626267;
  }
  .full-stack {
    color: var(--green);
  }
  .trainee-law {
    color: var(--orange);
  }
  .role-emoji {
    font-size: 18px;
    line-height: 1;
  }
  .intro-description {
    max-width: 870px;
    margin: 34px auto 0;
    color: #a7a7ad;
    font-size: clamp(18px, 2.25vw, 26px);
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: -0.018em;
  }
  .yellow-highlight {
    color: #f1f1f3;
    text-decoration: none;
    border-bottom: 1px solid #66666b;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .yellow-highlight:hover {
    color: var(--green);
    border-color: var(--green);
  }
  .yellow-highlight span {
    font-size: 0.7em;
  }
  .actions {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 27px;
    margin-top: 37px;
  }
  .resume-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    padding: 17px 20px;
    background: var(--green);
    color: #0b1910;
    font-size: 14px;
    font-weight: 750;
    text-decoration: none;
    border: 1px solid var(--green);
    border-radius: 9px;
    box-shadow: 0 10px 35px rgba(42, 198, 112, 0.12);
    transition:
      transform 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }
  .resume-download svg {
    width: 19px;
    height: 19px;
  }
  .resume-download:hover {
    transform: translateY(-3px);
    background: #57db91;
    box-shadow: 0 14px 35px rgba(42, 198, 112, 0.2);
  }
  .button-arrow {
    margin-left: 14px;
    font-size: 18px;
  }
  .technologies-link {
    font-size: 14px;
    color: #d4d4d8;
    text-decoration: none;
    padding: 13px 0;
    border-bottom: 1px solid #5c5c61;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .technologies-link:hover {
    color: var(--green);
    border-color: var(--green);
  }
  .technologies-link span {
    margin-left: 10px;
  }
  .hero-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 4vw, 46px);
    margin-top: clamp(65px, 9vw, 115px);
    padding-top: 26px;
    border-top: 1px solid #29292d;
  }
  .bottom-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: #85858c;
  }
  .bottom-index {
    color: var(--green);
    font-size: 10px;
  }
  .bottom-separator {
    height: 15px;
    width: 1px;
    background: #38383c;
  }
  .side-note {
    position: absolute;
    left: clamp(15px, 3vw, 48px);
    top: 50%;
    display: flex;
    align-items: center;
    gap: 20px;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    rotate: 180deg;
    color: #f3f3f4;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .side-rule {
    width: 1px;
    height: 65px;
    background: #55565c;
  }
  .side-caption {
    color: #676870;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }
  #typing::after {
    content: "|";
    color: var(--green);
    animation: blink 1s step-end infinite;
  }
  .corner-label {
    position: absolute;
    bottom: 35px;
    right: 40px;
    display: flex;
    gap: 13px;
    align-items: center;
    color: #72737a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .corner-label span {
    color: var(--green);
    font-size: 19px;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 1120px) {
    .side-note {
      display: none;
    }
  }
  @media (max-width: 740px) {
    .home {
      min-height: 100svh;
      padding: 100px 21px 70px;
    }
    .eyebrow {
      font-size: 9px;
      gap: 9px;
      letter-spacing: 0.12em;
    }
    .eyebrow-line {
      width: 22px;
    }
    .name-flag {
      gap: 10px;
      margin-top: 27px;
    }
    .onur-fullname {
      font-size: clamp(37px, 9vw, 67px);
    }
    .flag-link {
      width: 33px;
      height: 33px;
      padding: 5px;
    }
    .hero-divider {
      margin: 30px auto 28px;
    }
    .index-title {
      gap: 9px;
    }
    .role {
      padding: 10px 13px;
    }
    .intro-description {
      margin-top: 27px;
      font-size: clamp(17px, 4.5vw, 21px);
      line-height: 1.7;
    }
    .hero-bottom {
      margin-top: 70px;
      gap: 14px;
    }
    .bottom-item {
      gap: 6px;
      font-size: 8px;
      letter-spacing: 0.06em;
    }
    .corner-label {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .name-flag {
      flex-wrap: wrap;
    }
    .onur-fullname {
      font-size: clamp(30px, 8.8vw, 42px);
    }
    .flag-link {
      width: 29px;
      height: 29px;
    }
    .index-title {
      gap: 9px;
    }
    .intro-word {
      flex-basis: 100%;
    }
    .actions {
      flex-direction: column;
    }
    .resume-download {
      width: 100%;
      max-width: 270px;
    }
    .hero-bottom {
      flex-wrap: wrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero,
    #typing::after {
      animation: none;
    }
    .role,
    .flag-link,
    .resume-download {
      transition: none;
    }
  }
</style>
